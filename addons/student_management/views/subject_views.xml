<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->

    <record id="view_subject_tree"
            model="ir.ui.view">

        <field name="name">student.subject.tree</field>

        <field name="model">student.subject</field>

        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name='number_credits'/>
                <field name="code"/>
            </tree>
        </field>

    </record>


    <!-- Form View -->

    <record id="view_subject_form"
            model="ir.ui.view">

        <field name="name">student.subject.form</field>

        <field name="model">student.subject</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="code"/>
                        <field name="number_credits"/>
                        <field name="description"/>
                        <field name="enrollment_ids">
                            <tree editable="bottom">
                                <field name="student_id"/>
                                <field name="grade"/>
                                <field name="enrollment_date"/>
                            </tree>
                        </field>
                    </group>
                    <notebook>
                        <page string="Teacher">
                            <field name="teacher_id">
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="email"/>
                                            <field name="phone"/>
                                        </group>
                                        <group>
                                            <field name="hire_date"/>
                                            <field name="active"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>

            </form>

        </field>

    </record>


    <!-- Action -->

    <record id="action_subject"
            model="ir.actions.act_window">

        <field name="name">Subjects</field>

        <field name="res_model">student.subject</field>

        <field name="view_mode">tree,form</field>

    </record>


    <!-- Menu -->


    <menuitem id="menu_subject"
          parent="student_management.menu_student_root"
          name="Subjects"
          action="action_subject"/>

</odoo>