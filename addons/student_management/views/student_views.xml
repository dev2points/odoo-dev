<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->

    <record id="view_student_tree"
            model="ir.ui.view">

        <field name="name">student.student.tree</field>

        <field name="model">student.student</field>

        <field name="arch" type="xml">
            <tree>
                <field name="student_id"/>
                <field name="name"/>
                <field name="age"/>
                <field name="email"/>
                <field name="gender"/>
                <field name="gpa"/>
                <field name="active"/>
                <field name="birthday"/>
                <field name="department_id"/>
                <field name="status"/>
            </tree>
        </field>

    </record>


    <!-- Form View -->

    <record id="view_student_form"
            model="ir.ui.view">

        <field name="name">student.student.form</field>

        <field name="model">student.student</field>

        <field name="arch" type="xml">

            <form>

                <sheet>
                    <separator string="Student Information"/>
                    <group>
                        <group>

                            <field name="student_id"/>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="age"/>
                        </group>

                        <group>
                            <field name="email"/>
                            <field name="gender"/>
                            <field name="birthday"/>
                        </group>
                    </group>
                    <separator string="Academic Information"/>
                    <group>
                        <field name="gpa" readonly='1' /> 
                        <field name="department_id"/>
                        <field name="status"/>
                    </group>

                    <separator string="Others"/>
                    <group>
                        <field name="active"/>
                    </group>

                    <notebook>
                        <page string="Overview">

                        </page>
                        <page string="Grades">
                            <field name="grade_ids">
                                <tree editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="grade"/>
                                    <field name="enrollment_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Action -->

    <record id="action_student"
            model="ir.actions.act_window">

        <field name="name">Students</field>

        <field name="res_model">student.student</field>

        <field name="view_mode">tree,form</field>

    </record>


    <!-- Menu -->

    <menuitem id="menu_student_root"
              name="Student Management"/>

    <menuitem id="menu_student"
              parent="menu_student_root"
              name="Students"
              action="action_student"/>

</odoo>