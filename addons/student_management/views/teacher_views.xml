<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Tree View -->
<record id="view_teacher_tree"
        model="ir.ui.view">

    <field name="name">department.teacher.tree</field>

    <field name="model">department.teacher</field>

    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
            <field name="email"/>
            <field name="phone"/>
            <field name="hire_date"/>
            <field name="active"/>
        </tree>
    </field>
</record>

<!-- Form View -->
<record id="view_teacher_form"
        model="ir.ui.view">

    <field name="name">department.teacher.form</field>

    <field name="model">department.teacher</field>

    <field name="arch" type="xml">

        <form>

            <sheet>
                <separator string="Teacher Information"/>
                <group>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                </group>
                <separator string="Professional Information"/>
                <group>
                    <field name="hire_date"/>
                    <field name="active"/>
                </group>
            </sheet>

            <notebook>
                <page string="Subjects Taught">
                    <field name="subject_ids">
                        <tree editable="bottom">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="number_credits"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </form>

    </field>
</record>

<!-- Action -->
<record id="action_teacher"
        model="ir.actions.act_window">

    <field name="name">Teachers</field>

    <field name="res_model">department.teacher</field>

    <field name="view_mode">tree,form</field>
</record>

<!-- Menu -->
<menuitem id="menu_student_management_root"
          name="Student Management"/>
<menuitem id="menu_teacher"
          parent="menu_student_management_root"
          action="action_teacher"/>

</odoo>