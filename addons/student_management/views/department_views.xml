<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->

    <record id="view_department_tree"
            model="ir.ui.view">

        <field name="name">department.department.tree</field>

        <field name="model">department.department</field>

        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>

    </record>


    <!-- Form View -->

    <record id="view_department_form"
            model="ir.ui.view">

        <field name="name">department.department.form</field>

        <field name="model">department.department</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="student_count"/>
                        <field name="student_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="age"/>
                            </tree>
                        </field>
                        
                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Action -->

    <record id="action_department"
            model="ir.actions.act_window">

        <field name="name">Departments</field>

        <field name="res_model">department.department</field>

        <field name="view_mode">tree,form</field>

    </record>


    <!-- Menu -->


    <menuitem id="menu_department"
          parent="student_management.menu_student_root"
          name="Departments"
          action="action_department"/>

</odoo>