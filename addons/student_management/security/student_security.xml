<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_student_management"
            model="ir.module.category">
        <field name="name">Student Management</field>
    </record>

    <record id="group_student_user"
            model="res.groups">
        <field name="name">Student User</field>
        <field name="category_id"
               ref="student_management.module_category_student_management"/>
    </record>

    <record id="group_student_manager"
            model="res.groups">
        <field name="name">Student Manager</field>
        <field name="category_id"
               ref="student_management.module_category_student_management"/>
        <field name="implied_ids"
               eval="[(4, ref('student_management.group_student_user'))]"/>
    </record>

</odoo>