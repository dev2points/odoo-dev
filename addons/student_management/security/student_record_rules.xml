<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Student User chỉ được xem -->
    <record id="student_user_rule"
            model="ir.rule">

        <field name="name">
            Student User Read Rule
        </field>

        <field name="model_id"
               ref="model_student_student"/>

        <field name="domain_force">
            [(1,'=',1)]
        </field>

        <field name="groups"
               eval="[(4, ref('student_management.group_student_user'))]"/>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>

    </record>

</odoo>