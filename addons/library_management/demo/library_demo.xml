<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="demo_author_rowling" model="library.author">
        <field name="name">J. K. Rowling</field>
        <field name="code">AU2026001</field>
        <field name="country">United Kingdom</field>
        <field name="biography">Author of the Harry Potter series.</field>
    </record>

    <record id="demo_author_orwell" model="library.author">
        <field name="name">George Orwell</field>
        <field name="code">AU2026002</field>
        <field name="country">United Kingdom</field>
        <field name="biography">Known for dystopian fiction and political essays.</field>
    </record>

    <record id="demo_author_harari" model="library.author">
        <field name="name">Yuval Noah Harari</field>
        <field name="code">AU2026003</field>
        <field name="country">Israel</field>
        <field name="biography">Historian and author of popular non-fiction books.</field>
    </record>

    <record id="demo_category_fiction" model="library.category">
        <field name="name">Fiction</field>
        <field name="code">CT2026001</field>
        <field name="description">Novels and storytelling titles.</field>
    </record>

    <record id="demo_category_classic" model="library.category">
        <field name="name">Classic</field>
        <field name="code">CT2026002</field>
        <field name="description">Canonical and evergreen literature.</field>
    </record>

    <record id="demo_category_nonfiction" model="library.category">
        <field name="name">Non-fiction</field>
        <field name="code">CT2026003</field>
        <field name="description">Knowledge and reference books.</field>
    </record>

    <record id="demo_publisher_penguin" model="library.publisher">
        <field name="name">Penguin Books</field>
        <field name="phone">+44 20 0000 0001</field>
        <field name="email">contact@penguin.example</field>
        <field name="website">https://penguin.example</field>
        <field name="address">London</field>
    </record>

    <record id="demo_publisher_oreilly" model="library.publisher">
        <field name="name">O'Reilly Media</field>
        <field name="phone">+1 415 000 0002</field>
        <field name="email">info@oreilly.example</field>
        <field name="website">https://oreilly.example</field>
        <field name="address">Sebastopol</field>
    </record>

    <record id="demo_shelf_a1" model="library.shelf">
        <field name="code">SH2026001</field>
        <field name="name">Shelf A1</field>
        <field name="floor">1</field>
        <field name="zone">A</field>
        <field name="description">General fiction shelf.</field>
    </record>

    <record id="demo_shelf_a2" model="library.shelf">
        <field name="code">SH2026002</field>
        <field name="name">Shelf A2</field>
        <field name="floor">1</field>
        <field name="zone">A</field>
        <field name="description">Classic literature shelf.</field>
    </record>

    <record id="demo_shelf_b1" model="library.shelf">
        <field name="code">SH2026003</field>
        <field name="name">Shelf B1</field>
        <field name="floor">2</field>
        <field name="zone">B</field>
        <field name="description">Reference and non-fiction shelf.</field>
    </record>

    <record id="demo_member_anna" model="library.member">
        <field name="name">Anna Nguyen</field>
        <field name="gender">female</field>
        <field name="phone">0901000001</field>
        <field name="email">anna@example.com</field>
        <field name="address">Ha Noi</field>
    </record>

    <record id="demo_member_binh" model="library.member">
        <field name="name">Binh Tran</field>
        <field name="gender">male</field>
        <field name="phone">0901000002</field>
        <field name="email">binh@example.com</field>
        <field name="address">Da Nang</field>
    </record>

    <record id="demo_member_chi" model="library.member">
        <field name="name">Chi Pham</field>
        <field name="gender">other</field>
        <field name="phone">0901000003</field>
        <field name="email">chi@example.com</field>
        <field name="address">Ho Chi Minh City</field>
    </record>

    <record id="demo_book_hp_template" model="product.template">
        <field name="name">Harry Potter and the Philosopher's Stone</field>
        <field name="detailed_type">product</field>
        <field name="is_library_book">True</field>
        <field name="isbn">9780747532699</field>
        <field name="author_id" ref="demo_author_rowling"/>
        <field name="category_id" ref="demo_category_fiction"/>
        <field name="publisher_id" ref="demo_publisher_penguin"/>
        <field name="publish_year">1997</field>
        <field name="language">English</field>
        <field name="edition">1</field>
        <field name="description_library">A demo fiction title for library workflows.</field>
    </record>

    <record id="demo_book_1984_template" model="product.template">
        <field name="name">1984</field>
        <field name="detailed_type">product</field>
        <field name="is_library_book">True</field>
        <field name="isbn">9780451524935</field>
        <field name="author_id" ref="demo_author_orwell"/>
        <field name="category_id" ref="demo_category_classic"/>
        <field name="publisher_id" ref="demo_publisher_penguin"/>
        <field name="publish_year">1949</field>
        <field name="language">English</field>
        <field name="edition">1</field>
        <field name="description_library">A demo classic title for circulation tests.</field>
    </record>

    <record id="demo_book_sapiens_template" model="product.template">
        <field name="name">Sapiens: A Brief History of Humankind</field>
        <field name="detailed_type">product</field>
        <field name="is_library_book">True</field>
        <field name="isbn">9780062316097</field>
        <field name="author_id" ref="demo_author_harari"/>
        <field name="category_id" ref="demo_category_nonfiction"/>
        <field name="publisher_id" ref="demo_publisher_oreilly"/>
        <field name="publish_year">2011</field>
        <field name="language">English</field>
        <field name="edition">1</field>
        <field name="description_library">A demo non-fiction title for dashboard and borrow testing.</field>
    </record>

    <record id="demo_book_variant_hp" model="product.product">
        <field name="product_tmpl_id" ref="demo_book_hp_template"/>
        <field name="default_code">BK-HP-001</field>
    </record>

    <record id="demo_book_variant_1984" model="product.product">
        <field name="product_tmpl_id" ref="demo_book_1984_template"/>
        <field name="default_code">BK-1984-001</field>
    </record>

    <record id="demo_book_variant_sapiens" model="product.product">
        <field name="product_tmpl_id" ref="demo_book_sapiens_template"/>
        <field name="default_code">BK-SAP-001</field>
    </record>

    <record id="demo_copy_hp_1" model="stock.lot">
        <field name="name">BC2026-HP-001</field>
        <field name="product_id" ref="demo_book_variant_hp"/>
        <field name="shelf_id" ref="demo_shelf_a1"/>
        <field name="condition">good</field>
        <field name="note">First Harry Potter copy.</field>
    </record>

    <record id="demo_copy_hp_2" model="stock.lot">
        <field name="name">BC2026-HP-002</field>
        <field name="product_id" ref="demo_book_variant_hp"/>
        <field name="shelf_id" ref="demo_shelf_a1"/>
        <field name="condition">good</field>
        <field name="note">Second Harry Potter copy.</field>
    </record>

    <record id="demo_copy_1984_1" model="stock.lot">
        <field name="name">BC2026-1984-001</field>
        <field name="product_id" ref="demo_book_variant_1984"/>
        <field name="shelf_id" ref="demo_shelf_a2"/>
        <field name="condition">good</field>
        <field name="note">One 1984 copy for circulation.</field>
    </record>

    <record id="demo_copy_sapiens_1" model="stock.lot">
        <field name="name">BC2026-SAP-001</field>
        <field name="product_id" ref="demo_book_variant_sapiens"/>
        <field name="shelf_id" ref="demo_shelf_b1"/>
        <field name="condition">new</field>
        <field name="note">Reference copy on non-fiction shelf.</field>
    </record>

    <record id="demo_borrow_anna" model="library.borrow">
        <field name="name">BR2026001</field>
        <field name="member_id" ref="demo_member_anna"/>
        <field name="borrow_date">2026-07-01</field>
        <field name="due_date">2026-07-15</field>
        <field name="state">confirmed</field>
        <field name="note">Demo borrow record for Anna.</field>
        <field name="line_ids" eval="[(0, 0, {'product_id': ref('demo_book_variant_hp'), 'lot_id': ref('demo_copy_hp_1'), 'quantity': 1.0, 'note': 'Borrowed for reading club'}), (0, 0, {'product_id': ref('demo_book_variant_1984'), 'lot_id': ref('demo_copy_1984_1'), 'quantity': 1.0, 'note': 'Historical fiction study'})]"/>
    </record>

    <record id="demo_borrow_binh" model="library.borrow">
        <field name="name">BR2026002</field>
        <field name="member_id" ref="demo_member_binh"/>
        <field name="borrow_date">2026-07-03</field>
        <field name="due_date">2026-07-20</field>
        <field name="state">borrowed</field>
        <field name="note">Demo borrowed record for Binh.</field>
        <field name="line_ids" eval="[(0, 0, {'product_id': ref('demo_book_variant_sapiens'), 'lot_id': ref('demo_copy_sapiens_1'), 'quantity': 1.0, 'note': 'Research reading'})]"/>
    </record>

</odoo>