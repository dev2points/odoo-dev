<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="library_management.Dashboard" owl="1">
        <div class="o_library_dashboard_page">
            <div class="o_library_dashboard_header">
                <div>
                    <h1>Library Dashboard</h1>
                    <p>Library activity overview</p>
                </div>
            </div>

            <DashboardOverview/>

            <section class="o_library_dashboard_sections" aria-label="Dashboard sections">
                <BookSummary/>
                <CopySummary/>
                <MemberSummary/>
                <BorrowSummary/>
            </section>

            <section class="o_library_dashboard_charts" aria-label="Borrow statistics">
                <article class="o_library_chart_panel">
                    <h2>Borrow Count by Week</h2>
                    <t t-call="library_management.BarChart">
                        <t t-set="items" t-value="state.borrows.weekly_data || []"/>
                    </t>
                </article>
                <article class="o_library_chart_panel">
                    <h2>Borrow Count by Month</h2>
                    <t t-call="library_management.BarChart">
                        <t t-set="items" t-value="state.borrows.monthly_data || []"/>
                    </t>
                </article>
            </section>
        </div>
    </t>

    <t t-name="library_management.DashboardOverview" owl="1">
        <section class="o_library_overview_block" aria-label="Library overview">
            <div class="o_library_overview_title">
                <h2>Overview</h2>
                <span>This month</span>
            </div>
            <div class="o_library_dashboard_kpi">
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Books</t>
                    <t t-set="value" t-value="state.overview.total_books"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Copies</t>
                    <t t-set="value" t-value="state.overview.total_copies"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Members</t>
                    <t t-set="value" t-value="state.overview.total_members"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Loans</t>
                    <t t-set="value" t-value="state.overview.monthly_loans"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Weekly Revenue</t>
                    <t t-set="value" t-value="state.overview.weekly_revenue"/>
                    <t t-set="prefix">$</t>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Monthly Revenue</t>
                    <t t-set="value" t-value="state.overview.monthly_revenue"/>
                    <t t-set="prefix">$</t>
                </t>
            </div>
        </section>
    </t>

    <t t-name="library_management.BookSummary" owl="1">
        <section class="o_library_summary_block" aria-label="Book summary">
            <h2>Books</h2>
            <div class="o_library_dashboard_kpi">
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Titles</t>
                    <t t-set="value" t-value="state.books.total"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Copies</t>
                    <t t-set="value" t-value="state.books.copies"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Available</t>
                    <t t-set="value" t-value="state.books.available"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Borrowed</t>
                    <t t-set="value" t-value="state.books.borrowed"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Lost</t>
                    <t t-set="value" t-value="state.books.lost"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Damaged</t>
                    <t t-set="value" t-value="state.books.damaged"/>
                </t>
            </div>
        </section>
    </t>

    <t t-name="library_management.MemberSummary" owl="1">
        <section class="o_library_summary_block" aria-label="Member summary">
            <h2>Members</h2>
            <div class="o_library_dashboard_kpi">
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Total Members</t>
                    <t t-set="value" t-value="state.members.total"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Active</t>
                    <t t-set="value" t-value="state.members.active"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Archived</t>
                    <t t-set="value" t-value="state.members.archived"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Borrowing Now</t>
                    <t t-set="value" t-value="state.members.currently_borrowing"/>
                </t>
            </div>
        </section>
    </t>

    <t t-name="library_management.CopySummary" owl="1">
        <section class="o_library_summary_block" aria-label="Copy summary">
            <h2>Copies</h2>
            <div class="o_library_dashboard_kpi">
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Total Copies</t>
                    <t t-set="value" t-value="state.copies.total"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Available</t>
                    <t t-set="value" t-value="state.copies.available"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Borrowed</t>
                    <t t-set="value" t-value="state.copies.borrowed"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Lost</t>
                    <t t-set="value" t-value="state.copies.lost"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Damaged</t>
                    <t t-set="value" t-value="state.copies.damaged"/>
                </t>
            </div>
        </section>
    </t>

    <t t-name="library_management.BorrowSummary" owl="1">
        <section class="o_library_summary_block" aria-label="Borrow summary">
            <h2>Loans</h2>
            <div class="o_library_dashboard_kpi">
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Total Loans</t>
                    <t t-set="value" t-value="state.borrows.total"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Draft</t>
                    <t t-set="value" t-value="state.borrows.draft"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Approved</t>
                    <t t-set="value" t-value="state.borrows.approved"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Borrowed</t>
                    <t t-set="value" t-value="state.borrows.borrowed"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Returned</t>
                    <t t-set="value" t-value="state.borrows.returned"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">This Week</t>
                    <t t-set="value" t-value="state.borrows.this_week"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">This Month</t>
                    <t t-set="value" t-value="state.borrows.this_month"/>
                </t>
            </div>
        </section>
    </t>

    <t t-name="library_management.CatalogSummary" owl="1">
        <section class="o_library_summary_block" aria-label="Catalog summary">
            <h2>Catalog</h2>
            <div class="o_library_dashboard_kpi">
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Authors</t>
                    <t t-set="value" t-value="state.catalog.authors"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Publishers</t>
                    <t t-set="value" t-value="state.catalog.publishers"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Categories</t>
                    <t t-set="value" t-value="state.catalog.categories"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Shelves</t>
                    <t t-set="value" t-value="state.catalog.shelves"/>
                </t>
            </div>
        </section>
    </t>

    <t t-name="library_management.ShelfSummary" owl="1">
        <section class="o_library_summary_block" aria-label="Shelf summary">
            <h2>Shelves</h2>
            <div class="o_library_dashboard_kpi">
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Shelves</t>
                    <t t-set="value" t-value="state.catalog.shelves"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Active Shelves</t>
                    <t t-set="value" t-value="state.catalog.active_shelves"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Copies</t>
                    <t t-set="value" t-value="state.copies.total"/>
                </t>
                <t t-call="library_management.KpiCard">
                    <t t-set="label">Available</t>
                    <t t-set="value" t-value="state.copies.available"/>
                </t>
            </div>
        </section>
    </t>

    <t t-name="library_management.KpiCard" owl="1">
        <article class="o_library_kpi_card">
            <span t-esc="label"/>
            <strong>
                <t t-esc="typeof prefix !== 'undefined' ? prefix : ''"/>
                <t t-esc="state.loading ? '-' : (value || 0)"/>
            </strong>
        </article>
    </t>

    <t t-name="library_management.BarChart" owl="1">
        <div class="o_library_bar_chart">
            <t t-foreach="items" t-as="item" t-key="item.label">
                <div class="o_library_bar_item">
                    <span class="o_library_bar_label" t-esc="item.label"/>
                    <div class="o_library_bar_track">
                        <span class="o_library_bar_fill" t-att-style="'width: ' + item.percent + '%'"/>
                    </div>
                    <strong t-esc="item.count"/>
                </div>
            </t>
        </div>
    </t>

    <t t-name="library_management.BookListView" t-inherit="web.ListView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <BookSummary/>
            </div>
        </xpath>
    </t>

    <t t-name="library_management.BookKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <BookSummary/>
            </div>
        </xpath>
    </t>

    <t t-name="library_management.CopyListView" t-inherit="web.ListView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <CopySummary/>
            </div>
        </xpath>
    </t>

    <t t-name="library_management.CopyKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <CopySummary/>
            </div>
        </xpath>
    </t>

    <t t-name="library_management.MemberListView" t-inherit="web.ListView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <MemberSummary/>
            </div>
        </xpath>
    </t>

    <t t-name="library_management.BorrowListView" t-inherit="web.ListView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <BorrowSummary/>
            </div>
        </xpath>
    </t>

    <t t-name="library_management.BorrowKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <BorrowSummary/>
            </div>
        </xpath>
    </t>

    <t t-name="library_management.CatalogListView" t-inherit="web.ListView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <CatalogSummary/>
            </div>
        </xpath>
    </t>

    <t t-name="library_management.ShelfListView" t-inherit="web.ListView" t-inherit-mode="primary" owl="1">
        <xpath expr="//Layout" position="before">
            <div class="o_library_view_summary">
                <ShelfSummary/>
            </div>
        </xpath>
    </t>
</templates>
