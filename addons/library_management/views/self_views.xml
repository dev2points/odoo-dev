<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_shelf_tree" model="ir.ui.view">
        <field name="name">library.shelf.tree</field>
        <field name="model">library.shelf</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="floor"/>
                <field name="zone"/>
                <field name="copy_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_library_shelf_form" model="ir.ui.view">
        <field name="name">library.shelf.form</field>
        <field name="model">library.shelf</field>
        <field name="arch" type="xml">
            <form>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_view_copies"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book">

                            <field name="copy_count" widget="statinfo" string="Copies"/>

                        </button>

                    </div>

                    <group>

                        <group>

                            <field name="code"/>
                            <field name="name"/>
                            <field name="floor"/>
                            <field name="zone"/>
                            <field name="active"/>

                        </group>

                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                    <notebook>
                        <page string="Book Copies">
                            <field name="lot_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="condition"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="view_library_shelf_search" model="ir.ui.view">
        <field name="name">library.shelf.search</field>
        <field name="model">library.shelf</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="floor"/>
                <field name="zone"/>
            </search>
        </field>
    </record>

    <record id="action_library_shelf" model="ir.actions.act_window">
        <field name="name">Shelves</field>
        <field name="res_model">library.shelf</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
