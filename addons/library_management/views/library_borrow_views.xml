<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_borrow_search" model="ir.ui.view">
        <field name="name">library.borrow.search</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"/>
                <field name="member_id"/>

                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Borrowed" name="filter_borrowed" domain="[('state','=','borrowed')]"/>
                <filter string="Returned" name="filter_returned" domain="[('state','=','returned')]"/>

                <separator/>

                <group string="Group By" expand="0">
                    <filter string="Member" name="filter_member" context="{'group_by':'member_id'}"/>
                    <filter string="Borrow Date" name="filter_borrow_date" context="{'group_by':'borrow_date'}"/>
                    <filter string="State" name="filter_state" context="{'group_by':'state'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="view_library_borrow_tree" model="ir.ui.view">
        <field name="name">library.borrow.tree</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <tree js_class="library_borrow_list"
                  decoration-success="state == 'returned'"
                  decoration-warning="state == 'borrowed'"
                  decoration-info="state == 'confirmed'"
                  decoration-muted="state == 'cancel'">

                <field name="name"/>
                <field name="member_id"/>
                <field name="borrow_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="state" widget="badge"/>

            </tree>
        </field>
    </record>

    <record id="view_library_borrow_form" model="ir.ui.view">
        <field name="name">library.borrow.form</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <form>

                <header>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            states="draft"/>

                    <button name="action_borrow"
                            string="Borrow"
                            type="object"
                            class="btn-primary"
                            states="confirmed"/>

                    <button name="action_return"
                            string="Return"
                            type="object"
                            class="btn-success"
                            states="borrowed"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            states="draft,confirmed"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,borrowed,returned,cancel"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_view_picking"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-exchange">

                            <field name="move_count" widget="statinfo" string="Transfers"/>

                        </button>

                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="borrow_date"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="return_date"/>
                            <field name="picking_out_id" readonly="1"/>
                            <field name="picking_in_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Books">
                            <field name="line_ids" attrs="{'readonly':[('state','!=','draft')]}">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <record id="action_library_borrow" model="ir.actions.act_window">
        <field name="name">Borrow</field>
        <field name="res_model">library.borrow</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_library_borrow_search"/>
    </record>

</odoo>
