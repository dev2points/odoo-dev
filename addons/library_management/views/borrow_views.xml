<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_borrow_tree" model="ir.ui.view">
        <field name="name">library.borrow.tree</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <tree js_class="library_borrow_list" decoration-success="state == 'returned'" decoration-info="state == 'borrowed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="member_id"/>
                <field name="borrow_date"/>
                <field name="return_date"/>
                <field name="book_count"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_library_borrow_form" model="ir.ui.view">
        <field name="name">library.borrow.form</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_borrow" type="object" string="Borrow" class="btn-primary" attrs="{'invisible': [('state', 'not in', ('draft', 'approved'))]}"/>
                    <button name="action_return" type="object" string="Return" class="btn-primary" attrs="{'invisible': [('state', '!=', 'borrowed')]}"/>
                    <button name="action_cancel" type="object" string="Cancel" attrs="{'invisible': [('state', 'in', ('returned', 'cancelled'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,borrowed,returned,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="borrow_date"/>
                        </group>
                        <group>
                            <field name="return_date"/>
                            <field name="book_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="line_ids" attrs="{'readonly': [('state', 'in', ('borrowed', 'returned', 'cancelled'))]}">
                                <tree editable="bottom">
                                    <field name="book_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_borrow_kanban" model="ir.ui.view">
        <field name="name">library.borrow.kanban</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <kanban js_class="library_borrow_kanban" default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="member_id"/>
                <field name="borrow_date"/>
                <field name="book_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_library_borrow_card">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div>Member: <field name="member_id"/></div>
                            <div>Borrow Date: <field name="borrow_date"/></div>
                            <div>Books: <field name="book_count"/></div>
                            <div class="mt8">
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_library_borrowing" model="ir.actions.act_window">
        <field name="name">Borrowing</field>
        <field name="res_model">library.borrow</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem id="menu_library_borrowing" name="Borrowing" parent="menu_library_root" action="action_library_borrowing" sequence="40"/>
</odoo>
