<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_publisher_tree" model="ir.ui.view">
        <field name="name">library.publisher.tree</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <tree js_class="library_catalog_list">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="book_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_library_publisher_form" model="ir.ui.view">
        <field name="name">library.publisher.form</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <form>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_view_books"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book">

                            <field
                                name="book_count"
                                widget="statinfo"
                                string="Books"/>

                        </button>

                    </div>

                    <group>

                        <group>

                            <field name="name"/>

                            <field name="website"/>

                            <field name="active"/>

                        </group>

                        <group>

                            <field name="phone"/>

                            <field name="email"/>

                        </group>

                    </group>

                    <group>

                        <field name="address"/>

                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <record id="view_library_publisher_search" model="ir.ui.view">
        <field name="name">library.publisher.search</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"/>

                <field name="phone"/>

                <field name="email"/>

            </search>
        </field>
    </record>

    <record id="action_library_publisher"
            model="ir.actions.act_window">

        <field name="name">Publishers</field>

        <field name="res_model">library.publisher</field>

        <field name="view_mode">tree,form</field>

    </record>

</odoo>
